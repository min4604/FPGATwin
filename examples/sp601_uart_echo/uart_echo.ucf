# SP601 UART echo 範例的接腳約束
# 注意：原理圖上 L12 叫 USB_1_RX、K14 叫 USB_1_TX（以 CP2103 的角度命名），
# 以 FPGA 的角度則是 L12 = TX、K14 = RX。

NET "USER_CLOCK"   LOC = "V10" | IOSTANDARD = LVCMOS25;
TIMESPEC "TS_USER_CLOCK" = PERIOD "USER_CLOCK" 37.037 ns HIGH 50%;

NET "CPU_RESET"    LOC = "N4"  | IOSTANDARD = LVCMOS18;

NET "UART_TX"      LOC = "L12" | IOSTANDARD = LVCMOS25;
NET "UART_RX"      LOC = "K14" | IOSTANDARD = LVCMOS25;

NET "GPIO_LED<0>"  LOC = "E13" | IOSTANDARD = LVCMOS25;
NET "GPIO_LED<1>"  LOC = "C14" | IOSTANDARD = LVCMOS25;
NET "GPIO_LED<2>"  LOC = "C4"  | IOSTANDARD = LVCMOS25;
NET "GPIO_LED<3>"  LOC = "A4"  | IOSTANDARD = LVCMOS25;
